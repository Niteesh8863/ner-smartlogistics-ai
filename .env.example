# NER SmartLogistics AI — Environment Variables Configuration
# SIH26002 Problem Statement • MDoNER Platform

# Server Configuration
PROJECT_NAME="NER SmartLogistics AI"
API_V1_STR="/api/v1"
PORT=8000
DEBUG=False

# Security & Cryptography
SECRET_KEY="ner-smartlogistics-secure-production-secret-replace-in-prod"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Switch to PostgreSQL+PostGIS for enterprise production)
DATABASE_URL="sqlite:///./smartlogistics.db"
# DATABASE_URL="postgresql+psycopg2://postgres:postgres@localhost:5432/ner_smartlogistics"

# Redis Cache & Real-time PubSub (Optional)
REDIS_URL="redis://localhost:6379/0"

# External Meteorological & Disaster Feed Gateways (Optional Keys)
IMD_API_KEY=""
OPENWEATHER_API_KEY=""
BHUVAN_GATEWAY_TOKEN=""
NDMA_SACHET_ENDPOINT="https://sachet.ndma.gov.in/cap/v1.2"

# Simulation & Demonstration Mode
DEMO_MODE=True
SIMULATE_TELEMETRY=True

